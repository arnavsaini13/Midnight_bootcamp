// ----------------------------------------------------------------------------
// EXECUTION (Commitment Verification + Amount Revelation)
// ----------------------------------------------------------------------------
// PRIVACY:
//   - Amount revealed only at execution (on-chain transfer requirement)
//   - Proposer identity verified via commitment
// ANTI-MANIPULATION:
//   - Timelock ensures delay after passing (prevents flash loans)
//   - Commitment verification ensures amount integrity

#[zk_on_secret_input(amount, amountBlinding, proposerAddress, proposerBlinding)]
pub fn executeProposal(
    proposalId: Field,
    amount: Field,              // PRIVATE input (revealed here)
    amountBlinding: Field,      // PRIVATE witness
    proposerAddress: Address,   // PRIVATE input (verified here)
    proposerBlinding: Field     // PRIVATE witness
) {
    
    // Validate proposal state
    // let proposal = PROPOSALS[proposalId];
    // assert(proposal.isFinalized);
    // assert(proposal.isPassed);
    // assert(!proposal.isExecuted);
    
    // TIMELOCK ENFORCEMENT (ANTI-MANIPULATION)
    // assert(block.height >= proposal.executionEligibleBlock);
    
    // Verify amount commitment (INTEGRITY)
    let expectedAmountCommitment = poseidon_hash(amount, amountBlinding);
    // assert(expectedAmountCommitment == proposal.amountCommitment);
    
    // Verify proposer commitment (AUTHORIZATION)
    let expectedProposerCommitment = poseidon_hash(proposerAddress, proposerBlinding);
    // assert(expectedProposerCommitment == proposal.proposerCommitment);
    
    // Verify treasury balance
    assert(amount <= treasuryBalance);
    
    // Execute transfer (amount revealed only here)
    treasuryBalance = treasuryBalance - amount;
    // transfer(proposal.recipient, amount);
    
    // Mark as executed
    // PROPOSALS[proposalId].isExecuted = true;
}


// ----------------------------------------------------------------------------
// DEPOSIT FUNDS
// ----------------------------------------------------------------------------

#[zk_on_secret_input(amount)]
pub fn depositToTreasury(amount: Field) {
    assert(amount > 0);
    treasuryBalance = treasuryBalance + amount;
}


// ----------------------------------------------------------------------------
// QUERY FUNCTIONS (Public Safe Data Only)
// ----------------------------------------------------------------------------
// PRIVACY: Do NOT return vote totals, amounts, or proposer addresses
// Only return public status information

pub fn getTreasuryBalance() -> Field {
    treasuryBalance
}

pub fn getNextProposalId() -> Field {
    nextProposalId
}

pub fn getQuorumThreshold() -> Field {
    quorumThreshold
}

pub fn getMinimumProposerWeight() -> Field {
    minimumProposerWeight
}

pub fn getExecutionDelay() -> Field {
    executionDelay
}

