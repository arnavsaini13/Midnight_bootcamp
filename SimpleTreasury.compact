contract PrivateDAOTreasury {

    // --------------------
    // STATE
    // --------------------

    #[state]
    treasuryBalance: Field;

    #[state]
    admin: Address;

    #[state]
    proposalCount: Field;

    // proposal storage (flattened, compiler-friendly)
    #[state]
    proposalRecipient: Address;
    
    #[state]
    proposalAmount: Field;

    #[state]
    proposalActive: Bool;

    #[state]
    proposalExecuted: Bool;

    // --------------------
    // INITIALIZATION
    // --------------------

    #[init]
    constructor(initialBalance: Field) {
        treasuryBalance = initialBalance;
        admin = msg.sender;
        proposalCount = 0;
        proposalActive = false;
        proposalExecuted = false;
    }

    // --------------------
    // READ FUNCTIONS
    // --------------------

    pub fn getTreasuryBalance() -> Field {
        treasuryBalance
    }

    pub fn getActiveProposalAmount() -> Field {
        proposalAmount
    }

    pub fn isProposalActive() -> Bool {
        proposalActive
    }

    // --------------------
    // TREASURY MANAGEMENT
    // --------------------

    pub fn deposit(amount: Field) {
        assert!(amount > 0);
        treasuryBalance = treasuryBalance + amount;
    }

    // --------------------
    // PROPOSAL LIFECYCLE
    // --------------------

    pub fn createProposal(recipient: Address, amount: Field) {
        assert!(msg.sender == admin);
        assert!(!proposalActive);
        assert!(amount > 0);
        assert!(amount <= treasuryBalance);

        proposalRecipient = recipient;
        proposalAmount = amount;
        proposalActive = true;
        proposalExecuted = false;
        proposalCount = proposalCount + 1;
    }

    pub fn cancelProposal() {
        assert!(msg.sender == admin);
        assert!(proposalActive);
        assert!(!proposalExecuted);

        proposalActive = false;
    }

    pub fn executeProposal() {
        assert!(msg.sender == admin);
        assert!(proposalActive);
        assert!(!proposalExecuted);
        assert!(proposalAmount <= treasuryBalance);

        treasuryBalance = treasuryBalance - proposalAmount;
        proposalExecuted = true;
        proposalActive = false;

        transfer(proposalRecipient, proposalAmount);
    }

    // --------------------
    // GOVERNANCE
    // --------------------

    pub fn changeAdmin(newAdmin: Address) {
        assert!(msg.sender == admin);
        admin = newAdmin;
    }
}
