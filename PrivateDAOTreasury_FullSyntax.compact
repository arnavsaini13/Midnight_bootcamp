// DAO Treasury - Matching Original Syntax Pattern
// Features: Member registration, proposal creation, voting, execution

circuit PrivateDAOTreasury {
    
    // Proposal data structure
    struct Proposal {
        proposalId: Field,
        recipient: Address,
        amount: Field,
        creationTime: Field,
        deadline: Field,
        isActive: Bool,
        isFinalized: Bool,
        isPassed: Bool,
        yesVotesTotal: Field,
        noVotesTotal: Field
    }
    
    // Vote record structure
    struct VoteRecord {
        proposalId: Field,
        hasVoted: Bool
    }
    
    // State variables
    state treasuryBalance: Field = 0;
    state proposals: Map<Field, Proposal> = Map::new();
    state voteRecords: Map<Field, VoteRecord> = Map::new();
    state nextProposalId: Field = 1;
    state memberWeights: Map<Address, Field> = Map::new();
    state quorumThreshold: Field = 100;
    state minimumProposerWeight: Field = 10;
    state executionDelay: Field = 10;
    
    // Constructor
    #[init]
    constructor(initialBalance: Field, quorum: Field, minWeight: Field, delay: Field) {
        treasuryBalance = initialBalance;
        quorumThreshold = quorum;
        minimumProposerWeight = minWeight;
        executionDelay = delay;
    }
    
    // Treasury management
    pub fn deposit(amount: Field) {
        treasuryBalance = treasuryBalance + amount;
    }
    
    pub fn getTreasuryBalance() -> Field {
        treasuryBalance
    }
    
    // Member management
    pub fn registerMember(member: Address, weight: Field) {
        memberWeights.insert(member, weight);
    }
    
    pub fn getMemberWeight(member: Address) -> Field {
        match memberWeights.get(member) {
            Some(weight) => weight,
            None => 0
        }
    }
    
    // Proposal creation
    pub fn createProposal(recipient: Address, amount: Field, currentTime: Field) -> Field {
        let memberWeight = getMemberWeight(msg.sender);
        assert!(memberWeight >= minimumProposerWeight, "Insufficient weight");
        assert!(amount <= treasuryBalance, "Insufficient balance");
        
        let proposalId = nextProposalId;
        nextProposalId = nextProposalId + 1;
        
        let newProposal = Proposal {
            proposalId: proposalId,
            recipient: recipient,
            amount: amount,
            creationTime: currentTime,
            deadline: currentTime + 100,
            isActive: true,
            isFinalized: false,
            isPassed: false,
            yesVotesTotal: 0,
            noVotesTotal: 0
        };
        
        proposals.insert(proposalId, newProposal);
        proposalId
    }
    
    // Voting
    #[zk_on_secret_input(secret voteChoice)]
    pub fn castVote(proposalId: Field, voteChoice: Field, currentTime: Field) {
        let proposal = proposals.get(proposalId).unwrap();
        assert!(proposal.isActive, "Proposal not active");
        assert!(currentTime <= proposal.deadline, "Voting ended");
        
        let voteKey = hash(proposalId, msg.sender);
        let hasVoted = match voteRecords.get(voteKey) {
            Some(record) => record.hasVoted,
            None => false
        };
        assert!(!hasVoted, "Already voted");
        
        let voterWeight = getMemberWeight(msg.sender);
        assert!(voterWeight > 0, "Not a member");
        
        if (voteChoice > 0) {
            proposal.yesVotesTotal = proposal.yesVotesTotal + voterWeight;
        } else {
            proposal.noVotesTotal = proposal.noVotesTotal + voterWeight;
        }
        
        let voteRecord = VoteRecord {
            proposalId: proposalId,
            hasVoted: true
        };
        voteRecords.insert(voteKey, voteRecord);
        proposals.insert(proposalId, proposal);
    }
    
    // Finalization
    pub fn finalizeProposal(proposalId: Field, currentTime: Field) -> Bool {
        let proposal = proposals.get(proposalId).unwrap();
        assert!(proposal.isActive, "Proposal not active");
        assert!(currentTime > proposal.deadline, "Voting still open");
        
        let totalVotes = proposal.yesVotesTotal + proposal.noVotesTotal;
        assert!(totalVotes >= quorumThreshold, "Quorum not met");
        
        let passed = proposal.yesVotesTotal > proposal.noVotesTotal;
        
        proposal.isActive = false;
        proposal.isFinalized = true;
        proposal.isPassed = passed;
        
        proposals.insert(proposalId, proposal);
        passed
    }
    
    // Execution
    pub fn executeProposal(proposalId: Field, currentTime: Field) {
        let proposal = proposals.get(proposalId).unwrap();
        assert!(proposal.isFinalized, "Not finalized");
        assert!(proposal.isPassed, "Proposal failed");
        assert!(currentTime >= proposal.creationTime + executionDelay, "Timelock active");
        
        let amount = proposal.amount;
        let recipient = proposal.recipient;
        
        assert!(amount <= treasuryBalance, "Insufficient balance");
        
        treasuryBalance = treasuryBalance - amount;
        transfer(recipient, amount);
    }
    
    // Query
    pub fn getProposal(proposalId: Field) -> Proposal {
        proposals.get(proposalId).unwrap()
    }
}
