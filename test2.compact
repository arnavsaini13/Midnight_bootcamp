import Ledger;

type Proposal = {
    proposalId: Ledger.Field,
    recipient: Ledger.Address,
    isActive: Bool
};

contract PrivateDAOTreasury {
    # [state]
    treasuryBalance: Ledger.Field;
    
    #[init]
    constructor(initialBalance: Ledger.Field) {
        treasuryBalance = initialBalance;
    }
    
    pub fn getBalance() -> Ledger.Field {
        treasuryBalance
    }
}
